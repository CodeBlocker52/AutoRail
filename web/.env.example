# mock = in-memory demo data (default). onchain = real contracts on Aevum 44005.
NEXT_PUBLIC_AUTORAIL_MODE=mock

# WalletConnect Cloud project id (optional; injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Aevum testnet
NEXT_PUBLIC_AEVUM_RPC_URL=https://rpc-test.qday.info

# Contract addresses (fill in after deployment)
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_RECEIVABLE_REGISTRY_ADDRESS=
NEXT_PUBLIC_CREDIT_FACILITY_ADDRESS=
NEXT_PUBLIC_JOB_WALLET_FACTORY_ADDRESS=
NEXT_PUBLIC_REPAYMENT_ROUTER_ADDRESS=
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=

# Set to true once contracts are deployed (landing page then says "live")
NEXT_PUBLIC_DEPLOYED=false
