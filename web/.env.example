# ── Public (bundled into the browser) ─────────────────────────────────────────
# mock = in-memory demo (default) · onchain = real contracts
NEXT_PUBLIC_AUTORAIL_MODE=mock
# 44005 = QDay Aevum testnet (default) · 440050 = local fork (`make fork` in contracts/)
NEXT_PUBLIC_AUTORAIL_CHAIN_ID=44005
NEXT_PUBLIC_AEVUM_RPC_URL=https://rpc-test.qday.info
NEXT_PUBLIC_FORK_RPC_URL=http://127.0.0.1:8555
# true once contracts are live (landing page says "live on Aevum testnet")
NEXT_PUBLIC_DEPLOYED=true
# WalletConnect Cloud project id (optional; injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Server only (NEVER prefix with NEXT_PUBLIC_; on Vercel mark them Sensitive) ──
UNDERWRITER_PRIVATE_KEY=      # signs EIP-712 Offers (/api/underwrite)
RELAYER_PRIVATE_KEY=          # submits gasless EIP-3009 repayments (/api/relay)
PAYOUT_SESSION_PRIVATE_KEY=   # payout agent session key (/api/agents/payout, live demo)
LENDER_PRIVATE_KEY=           # live demo only
SELLER_PRIVATE_KEY=           # live demo only
BUYER_PRIVATE_KEY=            # live demo only
# Optional server RPC override (defaults to the public RPC of the target chain)
AUTORAIL_RPC_URL=
# Optional shared store for idempotency / rate limits / blocked attempts (Vercel KV or Upstash REST). Memory if unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=
