# ── Secrets: never commit ──────────────────────────────
# .env
# *.env
# .env.*
# *.env.*
!.env.example
!**/.env.example
keystores/
**/keystores/
*.key
*.pem

# Foundry broadcast logs can contain RPC data and signed txs; keep only public summaries in deployments/
contracts/broadcast/*/44005/*
contracts/broadcast/*/440050/*
